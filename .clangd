CompileFlags:
  Add:
    - "-I/home/bifrost/Documents/code/sm110a-kernel/include"
    - "-I/usr/local/cuda/include"
    - "-I/home/bifrost/miniforge3/lib/python3.13/site-packages/nvidia/nccl/include"
    - "-I/usr/local/cuda/include/cccl"
    - "--cuda-path=/usr/local/cuda"
    - "--cuda-gpu-arch=sm_110a"
---
If:
  PathMatch: .*_torch_binding\.cpp
CompileFlags:
  Add:
    - "-std=c++20"
    - "-I/home/bifrost/miniforge3/lib/python3.13/site-packages/torch/include"
    - "-I/home/bifrost/miniforge3/lib/python3.13/site-packages/torch/include/torch/csrc/api/include"
    - "-I/home/bifrost/miniforge3/include/python3.13"
    - "-DTORCH_EXTENSION_NAME=clangd_torch_extension"
